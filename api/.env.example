# Project Settings
PROJECT_NAME=RoyaltyFlow API
ENVIRONMENT=development
PORT=8000

# Database Configuration (PostgreSQL with asyncpg or SQLite with aiosqlite)
# For local testing without PostgreSQL server:
DATABASE_URL=sqlite+aiosqlite:///./royaltyflow.db
# For production PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/royaltyflow

# Google Gemini AI LLM Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Avalanche Fuji C-Chain Network & RPC
RPC_URL=https://api.avax-test.network/ext/bc/C/rpc
CHAIN_ID=43113

# Deployed Smart Contracts Addresses on Avalanche Fuji
MOCK_USDC_ADDRESS=0x5412497645F3aA76b50eB2aEc59c77c908587b1c
CONTENT_REGISTRY_ADDRESS=0x789b5c3F3c8340dAfE942D5eB684F66a2E4b2160
ROYALTY_SPLITTER_ADDRESS=0xa522A00E9C7330755F19652a21F24FE3956E3d23
PAYMENT_VAULT_ADDRESS=0xE61099f18731f24C32439169faA361e272a08892
LICENSE_MANAGER_ADDRESS=0x6E57E88a2a8b9f71c4cFE7CDEc7e0c4D99bEb86B

